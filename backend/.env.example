# Spotify OAuth Credentials
# You can get these by creating an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Secret key used to sign per-user session cookies (generate any random string for production/Vercel)
SESSION_SECRET_KEY=replace_with_a_long_random_secret_string

# The redirect URI must match what you configure in the Spotify Developer Dashboard.
# Locally, keep http://127.0.0.1:8000/api/spotify/callback.
# On Vercel, CleanPlaylist will auto-detect https://<your-domain>.vercel.app/api/spotify/callback,
# or you can set SPOTIFY_REDIRECT_URI explicitly in Vercel Environment Variables.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
