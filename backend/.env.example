# Spotify OAuth Credentials
# You can get these by creating an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# The redirect URI must perfectly match what you configure in the Spotify Dashboard.
# If you are running locally, keep it as this.
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
